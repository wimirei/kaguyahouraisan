@model thrucommunity.Models.PlayerProfileViewModel
@using thrucommunity.Models
@using thrucommunity.Services
@using thrucommunity.Data

@{
    ViewData["Title"] = Model.Player.Nickname;
}

<div class="container mt-4" style="max-width: 1000px;">
    <div class="mb-4 text-center">

        <h1 class="display-5 fw-bold">
            @Model.Player.Nickname
        </h1>

        <p class="text-secondary">
            Профиль игрока
        </p>
    </div>


            <div class="card shadow-sm mb-4">

                <div class="card-header fw-bold">
                    Статистика
                </div>

            <div class="card-body p-0">
                    <ul class="card-list">
                        <li class="card-list-item">
                            L1CC: @Model.Player.L1CCcount
                        </li>

                        <li class="card-list-item">
                            LNB: @Model.Player.LNBcount
                        </li>

                        <li class="card-list-item">
                            LNB+: @Model.Player.LNBNxcount
                        </li>

                        <li class="card-list-item">
                            LNM: @Model.Player.LNMcount
                        </li>

                        <li class="card-list-item">
                            LNN: @Model.Player.LNNcount
                        </li>

                        <li class="card-list-item">
                            LNNN: @Model.Player.LNNNcount
                        </li>

                        <li class="card-list-item">
                            ExNN(N): @Model.Player.ExNNcount
                        </li>

                        <li class="card-list-item">
                            🥇@Model.Player.FirstPlaceCount
                        </li>

                        <li class="card-list-item">
                            🥈 @Model.Player.SecondPlaceCount
                        </li>

                        <li class="card-list-item">
                            🥉@Model.Player.ThirdPlaceCount
                        </li>

                        <li class="card-list-item">
                            WR @Model.Player.WRcount
                        </li>
                    </ul>
                </div>
    </div>

    <div class="card shadow-sm mb-2 best-results-card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span class="fw-bold">
                Лучшие результаты
            </span>

            <div class="btn-group btn-group-sm">

                <button id="btnSurvival"
                        class="btn btn-primary">
                    Cурвайвол
                </button>

                <button id="btnScoring"
                        class="btn btn-outline-primary">
                    Скоринг
                </button>

            </div>

        </div>

        <div class="card-body p-0">

            <div id="survivalTable">

                 <div class="table-responsive">

                 <table class="table table-hover table-sm align-middle mb-0 best-results-table">

                    <thead>
                        <tr>
                            <th>Игра</th>

                            @foreach (Difficulty difficulty in Enum.GetValues(typeof(Difficulty)))
                            {
                                    <th>
                                        <span class="badge @difficulty.BadgeDiffClass()">
                                            @difficulty
                                        </span>
                                    </th>
                            }

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (TouhouGame game in Enum.GetValues(typeof(TouhouGame)))
                        {
                            <tr>

                                <td>
                                    <span class="badge @game.BadgeGameClass()">
                                        @game
                                    </span>
                                </td>

                                @foreach (Difficulty difficulty in Enum.GetValues(typeof(Difficulty)))
                                {
                                    var cell = Model.BestSurvivalResults[game][difficulty];

                                    <td class="text-center">

                                        @if (cell.Replay != null)
                                        {
                                            <a asp-controller="Replay"
                                               asp-action="Replay"
                                               asp-route-id="@cell.Replay.Id"
                                               class="text-decoration-none">

                                                <span class="badge @ReplayService.BadgeResultClass(cell.Replay)">
                                                    @ReplayService.BuildTypeOfSurvival(cell.Replay)
                                                </span>

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">—</span>
                                        }

                                    </td>
                                }

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>  
            </div>

            <div id="scoringTable" style="display:none;">

                <div class="table-responsive">

                    <table class="table table-hover mb-0 best-results-table">

                        <thead>

                            <tr>

                                <th>Игра</th>

                                @foreach (Difficulty difficulty in Enum.GetValues(typeof(Difficulty)))
                                {
                                    <th>
                                        <span class="badge @difficulty.BadgeDiffClass()">
                                            @difficulty
                                        </span>
                                    </th>
                                }

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (TouhouGame game in Enum.GetValues(typeof(TouhouGame)))
                            {
                                <tr>

                                    <td>
                                        <span class="badge @game.BadgeGameClass()">
                                            @game
                                        </span>
                                    </td>

                                    @foreach (Difficulty difficulty in Enum.GetValues(typeof(Difficulty)))
                                    {
                                        var cell = Model.BestScoringResults[game][difficulty];

                                        <td>

                                            @if (cell.Replay != null)
                                            {
                                                <a asp-controller="Replay"
                                                   asp-action="Replay"
                                                   asp-route-id="@cell.Replay.Id"
                                                   class="text-decoration-none">

                                                    @String.Format("{0:N0}", cell.Replay.Score)

                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">—</span>
                                            }

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
            </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <div class="d-flex flex-wrap gap-1 mb-2" id="gameSelector">

                @foreach (TouhouGame game in Enum.GetValues(typeof(TouhouGame)))
                {
                    <button type="button"
                            class="btn btn-sm @(game == TouhouGame.EoSD ? "btn-primary" : "btn-outline-primary") game-btn"
                            data-game="@game">
                        @game
                    </button>
                }

            </div>

            <div class="btn-group btn-group-sm">

                <button id="btnShotSurvival"
                        class="btn btn-primary">
                    Сурвайвол
                </button>

                <button id="btnShotScoring"
                        class="btn btn-outline-primary">
                    Скоринг
                </button>

            </div>

        </div>

        <div class="card-body p-0">
            @foreach (TouhouGame game in Enum.GetValues(typeof(TouhouGame)))
            {
                <!-- СУРВ -->
                <div class="shot-table"
                     data-game="@game"
                     data-category="Survival"
                     style="display:@(game == TouhouGame.EoSD ? "block" : "none")">

                    <div class="table-responsive">

                        <table class="table table-hover table-sm align-middle mb-0 best-results-table">

                            <thead>

                                <tr>

                                    <th>Шоттип</th>

                                    @foreach (var difficulty in GameData.Difficulties[game])
                                    {
                                        <th class="text-center">
                                            <span class="badge @difficulty.BadgeDiffClass()">
                                                @difficulty
                                            </span>
                                        </th>
                                    }

                                </tr>

                            </thead>

                            <tbody>

                                @{
                                    var shotTypes = GameData.ShotTypes[game].ToList();

                                    if (game == TouhouGame.HSiFS)
                                    {
                                        shotTypes.AddRange(new[]
                                        {
                                            "Reimu",
                                            "Marisa",
                                            "Cirno",
                                            "Aya"
                                        });
                                    }
                                }

                                @foreach (var shot in shotTypes)
                                {
                                    <tr>

                                        <td class="fw-semibold">
                                            @shot
                                        </td>

                                        @foreach (var difficulty in GameData.Difficulties[game])
                                        {
                                            var cell = Model.SurvivalTables[game][difficulty][shot];

                                            <td class="text-center">

                                                @if (cell.Replay != null)
                                                {
                                                    <a asp-controller="Replay"
                                                       asp-action="Replay"
                                                       asp-route-id="@cell.Replay.Id"
                                                       class="text-decoration-none">

                                                        <span class="badge @ReplayService.BadgeResultClass(cell.Replay)">
                                                            @ReplayService.BuildTypeOfSurvival(cell.Replay)
                                                        </span>

                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">—</span>
                                                }

                                            </td>
                                        }

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>



                <!-- СКОРИНГ -->

                <div class="shot-table"
                     data-game="@game"
                     data-category="Scoring"
                     style="display:none;">

                    <div class="table-responsive">

                        <table class="table table-hover table-sm align-middle mb-0 best-results-table">

                            <thead>

                                <tr>

                                    <th>Шоттип</th>

                                    @foreach (var difficulty in GameData.Difficulties[game])
                                    {
                                        <th class="text-center">
                                            <span class="badge @difficulty.BadgeDiffClass()">
                                                @difficulty
                                            </span>
                                        </th>
                                    }

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var shot in GameData.ShotTypes[game])
                                {
                                    <tr>

                                        <td class="fw-semibold">
                                            @shot
                                        </td>

                                        @foreach (var difficulty in GameData.Difficulties[game])
                                        {
                                            var cell = Model.ScoringTables[game][difficulty][shot];

                                            <td class="text-center">

                                                @if (cell.Replay != null)
                                                {
                                                    <a asp-controller="Replay"
                                                       asp-action="Replay"
                                                       asp-route-id="@cell.Replay.Id"
                                                       class="text-decoration-none">

                                                        @String.Format("{0:N0}", cell.Replay.Score)

                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">—</span>
                                                }

                                            </td>
                                        }

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>
            }



        </div>

    </div>

        <div class="card-body p-0">



            <div class="card shadow-sm mb-4">
                <div class="card-header fw-bold">
                    Последние реплеи
                </div>

                <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Игра</th>
                                <th>Сложность</th>
                                <th>Шоттип</th>
                                <th>Категория</th>
                                <th>Результат</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var replay in Model.RecentReplays)
                            {
                                <tr>
                                    <td>
                                        @(replay.ReplayDate?.ToString("dd.MM.yyyy") ?? "-")
                                    </td>
                                    <td>
                                        <span class="badge @replay.Game.BadgeGameClass()">
                                            @replay.Game
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @replay.Difficulty.BadgeDiffClass()">
                                            @replay.Difficulty
                                        </span>
                                    </td>

                                    <td>
                                        @replay.ShotType
                                    </td>

                                    <td>
                                        @replay.Category
                                    </td>

                                    <td>
                                        @if (replay.Category == RunCategory.Scoring)
                                        {
                                            @replay.Score
                                        }
                                        else
                                        {
                                            @replay.TypeOfSurvival
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Replay"
                                           asp-action="Replay"
                                           asp-route-id="@replay.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Подробнее
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header fw-bold">
            Все реплеи
        </div>

    <div class="card-body p-0" style="max-height: 520px; overflow-y: auto;">
            
            <table class="table table-hover mb-0">

                <thead>
                    <tr>

                        <th>Дата</th>
                        <th>Игра</th>
                        <th>Сложность</th>
                        <th>Шоттип</th>
                        <th>Категория</th>
                        <th>Результат</th>
                        <th></th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var replay in Model.AllReplays)
                    {
                        <tr>

                            <td>
                                 @(replay.ReplayDate?.ToString("dd.MM.yyyy") ?? "-")
                            </td>

                            <td>
                                <span class="badge @replay.Game.BadgeGameClass()">
                                    @replay.Game
                                </span>

                            </td>
                            <td>
                                <span class="badge @replay.Difficulty.BadgeDiffClass()">
                                    @replay.Difficulty
                                </span>

                            </td>

                            <td>
                                @replay.ShotType
                            </td>

                            <td>
                                @replay.Category
                            </td>

                            <td>

                                @if (replay.Category == RunCategory.Scoring)
                                {
                                    @replay.Score
                                }
                                else
                                {
                                    @replay.TypeOfSurvival
                                }

                            </td>

                            <td>
                                <a asp-controller="Replay"
                                   asp-action="Replay"
                                   asp-route-id="@replay.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Подробнее
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
    </div>
</div>

<script>

    // ---------- Лучшие результаты ----------

    const btnSurvival = document.getElementById("btnSurvival");
    const btnScoring = document.getElementById("btnScoring");

    const survivalTable = document.getElementById("survivalTable");
    const scoringTable = document.getElementById("scoringTable");

    btnSurvival.addEventListener("click", () => {

        survivalTable.style.display = "";
        scoringTable.style.display = "none";

        btnSurvival.classList.replace("btn-outline-primary", "btn-primary");
        btnScoring.classList.replace("btn-primary", "btn-outline-primary");

    });

    btnScoring.addEventListener("click", () => {

        survivalTable.style.display = "none";
        scoringTable.style.display = "";

        btnScoring.classList.replace("btn-outline-primary", "btn-primary");
        btnSurvival.classList.replace("btn-primary", "btn-outline-primary");

    });


    // ---------- Таблицы всех игр по шоттипам и сложностям ----------

    let currentGame = "@TouhouGame.EoSD";
    let currentCategory = "Survival";

    const shotTables = document.querySelectorAll(".shot-table");
    const gameButtons = document.querySelectorAll(".game-btn");

    const btnShotSurvival = document.getElementById("btnShotSurvival");
    const btnShotScoring = document.getElementById("btnShotScoring");

    function updateShotTables() {

        shotTables.forEach(table => {

            if (table.dataset.game === currentGame &&
                table.dataset.category === currentCategory)
            {
                table.style.display = "";
            }
            else
            {
                table.style.display = "none";
            }

        });

    }


    // Переключение игры

    gameButtons.forEach(button => {

        button.addEventListener("click", () => {

            currentGame = button.dataset.game;

            gameButtons.forEach(btn => {
                btn.classList.replace("btn-primary", "btn-outline-primary");
            });

            button.classList.replace("btn-outline-primary", "btn-primary");

            updateShotTables();

        });

    });


    // Сурв

    btnShotSurvival.addEventListener("click", () => {

        currentCategory = "Survival";

        btnShotSurvival.classList.replace("btn-outline-primary", "btn-primary");
        btnShotScoring.classList.replace("btn-primary", "btn-outline-primary");

        updateShotTables();

    });


    // Скоринг

    btnShotScoring.addEventListener("click", () => {

        currentCategory = "Scoring";

        btnShotScoring.classList.replace("btn-outline-primary", "btn-primary");
        btnShotSurvival.classList.replace("btn-primary", "btn-outline-primary");

        updateShotTables();

    });


    updateShotTables();

</script>