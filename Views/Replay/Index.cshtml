@model ReplayListViewModel

@{
    ViewData["Title"] = "Реплеи";
    ViewData["Description"] = "Реплеи (повторы) игроков.";
    ViewData["Canonical"] = $"https://kaguyahouraisan.com/Replays";
}

<div class="d-flex justify-content-center align-items-center mb-4">
    <h1 class="mb-0">Реплеи</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="d-flex justify-content-center mb-4">

    <div class="alert alert-success alert-dismissible fade show w-75 shadow-sm"
         role="alert">

        <strong>✓ Успешно!</strong>
        Реплей успешно отправлен и ожидает проверки модератором.

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>

</div>
}
<div class="container mt-4" style="max-width: 1050px;">
<div class="table-responsive">
        <table class="table table-striped table-hover replay-table">
        <thead class="table-dark">
            <tr>
                <th class="player-column">Игрок</th>
                <th>Игра</th>
                <th>Шоттип</th>
                <th>Результат</th>
                <th>Дата загрузки</th>
                <th class="comment-column">Комментарий</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Replays)
            {
                <tr>
                    <td>
                        <a asp-controller="Players"
                           asp-action="Profile"
                           asp-route-nickname="@item.Nickname">@item.Nickname</a>
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.Game)</td>
                    <td>@Html.DisplayFor(modelItem => item.ShotType)</td>
                    <td>
                        @if (item.Category == RunCategory.Scoring)
                        {
                            <a asp-action="Replay" asp-route-id="@item.Id">@item.Score?.ToString("N0")</a>
                        }
                        else
                        {
                            <a asp-action="Replay" asp-route-id="@item.Id">@item.TypeOfSurvival</a>
                        }
                    </td>
                        <td>
                            @item.SubmittedAtUtc.ToString("dd.MM.yyyy HH:mm")
                        </td>
                        <td class="comment-column">
                            @if (item.Comment != null && item.Comment.Length > 50)
                            {
                                @item.Comment.Substring(0, 30)
                                @:...
                            }
                            else
                            {
                                @item.Comment
                            }
                        </td>
                </tr>
            }
            </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <!-- Прошлая страница -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    &laquo;
                </a>
            </li>

            @{
                int start = Math.Max(1, Model.CurrentPage - 2);
                int end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }

            @if (start > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-route-page="1">1</a>
                </li>

                @if (start > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            @if (end < Model.TotalPages)
            {
                @if (end < Model.TotalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                <li class="page-item">
                    <a class="page-link"
                       asp-route-page="@Model.TotalPages">
                        @Model.TotalPages
                    </a>
                </li>
            }

            <!-- Некст страница -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    &raquo;
                </a>
            </li>

        </ul>
    </nav>
}
</div>
