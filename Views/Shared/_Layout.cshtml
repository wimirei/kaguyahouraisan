<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewData["Description"]" />

    <meta name="keywords" content="Touhou, Touhou Project, leaderboard, high scores, replays, rankings, achievements, тохо, тоухоу, реплеи, повторы, тохо проект, восточный проект, тохо лунатик, тохо сообщество, тохо фд, лунатик, нормал, лиддерборды, таблица лиддеров, рекорды, скоринг, сурвайвол" />

    <meta name="author" content="Kaguya Houraisan" />

    <link rel="canonical" href="@(ViewData["Canonical"] ?? $"https://kaguyahouraisan.com{Context.Request.Path}")" />

    <title>@ViewData["Title"] - Kaguya Houraisan</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/thrucommunity.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light custom-navbar box-shadow mb-3">
            <div class="container-fluid">
                <img src="~/images/design/main_menu2navbar.png"
                     class="navbar-character" />

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Главная
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Replay" asp-action="Index">Реплеи</a>
                        </li>
                        <li class="nav-item">
                            <div class="dropdown">
                            <button class="btn btn-replay dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                                Рекорды
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                                <a class="nav-link" asp-area="" asp-controller="Challenges" asp-action="LNB">Lunatic No Bomb</a>
                                <a class="nav-link" asp-area="" asp-controller="Challenges" asp-action="LNN">Lunatic No Miss No Bomb</a>
                                <a class="nav-link" asp-area="" asp-controller="Challenges" asp-action="ExNN">Extra No Miss No Bomb</a>
                                <a class="nav-link" asp-area="" asp-controller="Challenges" asp-action="Scoring">Скоринг</a>
                            </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Players" asp-action="Players">Игроки</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Resources">Полезные материалы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">О сайте</a>
                        </li>
                    </ul>

                    <a class="btn btn-replay ms-auto"
                       asp-controller="Replay"
                       asp-action="Create">
                        Загрузить реплей
                    </a>
                    <!--
                    <button id="themeButton"
                            class="btn btn-outline-secondary ms-3"
                            type="button">
                        <i class="bi bi-moon-stars-fill"></i>
                    </button>
                    -->

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - wimirei - <a asp-area="" asp-controller="Home" asp-action="Privacy">Политика приватности </a> | <a asp-area="" asp-controller="Home" asp-action="Contact">Контакты</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
